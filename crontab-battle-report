#     done

# 示例3: 每周日凌晨 02:00 更新战报回看页面
# 0 2 * * 0 /usr/local/bin/node /Users/yesu/zhijifcweekly/scripts/modern-matches.js >> /Users/yesu/zhijifcweekly/logs/battle-report/cron-update.log 2>&1

# 示例4: 每天凌晨 03:00 清理旧日志（保留7天）
# 0 3 * * * find /Users/yesu/zhijifcweekly/logs/battle-report -name "*.log" -mtime +7 -delete

